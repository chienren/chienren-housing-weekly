      "publishedAt": "2026-09-07",
      "relativeTime": "72小時內",
      "url": "https://www.mof.gov.tw/singlehtml/384fb3077bb349ea973e7fc6f13b6974?cntId=4faec3b532d746068555fb33fb810682",
